---
services:
  crowdsec:
    image: docker.io/crowdsecurity/crowdsec:v1.8.1-debian
    container_name: crowdsec
    restart: unless-stopped
    environment:
      COLLECTIONS: "crowdsecurity/traefik crowdsecurity/linux crowdsecurity/sshd"
      BOUNCER_KEY_firewall: "{{ crowdsec_bouncer_key }}"
      DOCKER_HOST: tcp://crowdsec-socket-proxy:2375
    ports:
      - "127.0.0.1:8082:8080"
    networks:
      - crowdsec
    volumes:
      - /srv/prod/crowdsec/acquis.yaml:/etc/crowdsec/acquis.yaml:ro
      - /var/log/journal:/var/log/host:ro
      - crowdsec-db:/var/lib/crowdsec/data
      - crowdsec-config:/etc/crowdsec
    depends_on:
      - crowdsec-socket-proxy

  crowdsec-socket-proxy:
    image: docker.io/tecnativa/docker-socket-proxy:latest
    container_name: crowdsec-socket-proxy
    restart: unless-stopped
    environment:
      CONTAINERS: 1
      EVENTS: 1
      INFO: 1
      PING: 1
      VERSION: 1
      # everything else stays denied - this proxy only needs to let
      # crowdsec read container metadata/logs, never mutate anything
      AUTH: 0
      BUILD: 0
      COMMIT: 0
      CONFIGS: 0
      EXEC: 0
      IMAGES: 0
      NETWORKS: 0
      NODES: 0
      PLUGINS: 0
      POST: 0
      SECRETS: 0
      SERVICES: 0
      SWARM: 0
      SYSTEM: 0
      TASKS: 0
      VOLUMES: 0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - crowdsec
    read_only: true
    tmpfs:
      - /run
      - /tmp

networks:
  crowdsec:
    driver: bridge

volumes:
  crowdsec-db:
  crowdsec-config:
