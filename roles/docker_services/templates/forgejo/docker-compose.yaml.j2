---
networks:
  forgejo:
    external: false
  proxy:
    external: true

services:
  server:
    image: codeberg.org/forgejo/forgejo:16.0.4
    container_name: forgejo
    environment:
      - USER_UID=1000
      - USER_GID=1000
    restart: always
    networks:
      - forgejo
      - proxy
    volumes:
      - /srv/prod/forgejo:/data
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "222:22"
    labels:
      - "backup.sqlite-path=/srv/prod/forgejo/gitea/gitea.db"
      - "traefik.enable=true"
      - "traefik.http.routers.forgejo.tls=true"
      - "traefik.http.routers.forgejo.rule=Host(`git.{{ root_domain }}`)"
      - "traefik.http.routers.forgejo.entrypoints=https"
      - "traefik.http.routers.forgejo.service=forgejo"
      - "traefik.http.routers.forgejo.middlewares=chain-public@file"
      - "traefik.http.services.forgejo.loadbalancer.server.port=3000"
